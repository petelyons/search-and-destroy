[
  {
    "label": "Run Game (JavaFX)",
    "command": "mvn javafx:run",
    "use_new_terminal": true,
    "allow_concurrent_runs": false
  },
  {
    "label": "Run Tests",
    "command": "mvn clean test",
    "use_new_terminal": true,
    "allow_concurrent_runs": false
  },
  {
    "label": "Build",
    "command": "mvn clean compile",
    "use_new_terminal": true,
    "allow_concurrent_runs": false
  },
  {
    "label": "Run AI Test CLI",
    "command": "mvn compile exec:java -Dexec.mainClass=com.developingstorm.games.sad.testing.AITestCLI",
    "use_new_terminal": true,
    "allow_concurrent_runs": false
  }
]

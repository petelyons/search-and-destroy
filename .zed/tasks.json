[
  {
    "label": "Build Project",
    "command": "mvn clean compile",
    "use_new_terminal": false,
  },
  {
    "label": "Run Game",
    "command": "MAVEN_OPTS=\"-Dsun.java2d.opengl=true -Dapple.awt.graphics.UseQuartz=true -Dswing.aatext=true -Dawt.useSystemAAFontSettings=lcd -Dsun.java2d.renderer=sun.java2d.marlin.MarlinRenderingEngine\" mvn exec:java -Dexec.mainClass=SAD",
    "use_new_terminal": true,
  },
  {
    "label": "Run Game (No OpenGL)",
    "command": "mvn exec:java -Dexec.mainClass=SAD",
    "use_new_terminal": true,
  },
  {
    "label": "Package JAR",
    "command": "mvn clean package",
    "use_new_terminal": false,
  },
  {
    "label": "Run JAR",
    "command": "java -Dsun.java2d.opengl=true -Dapple.awt.graphics.UseQuartz=true -Dswing.aatext=true -Dawt.useSystemAAFontSettings=lcd -Dsun.java2d.renderer=sun.java2d.marlin.MarlinRenderingEngine -jar target/sad-game-1.0.0.jar",
    "use_new_terminal": true,
  },
  {
    "label": "Run JAR (No OpenGL)",
    "command": "java -jar target/sad-game-1.0.0.jar",
    "use_new_terminal": true,
  },
  {
    "label": "Run Tests",
    "command": "mvn test",
    "use_new_terminal": false,
  },
]

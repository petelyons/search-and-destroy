<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Console appender for normal gameplay -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Optional file appender for normal gameplay (disabled by default) -->
    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>SaD.log</file>
        <append>true</append>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- IMPORTANT: The Log wrapper now uses the context object's class for the logger -->
    <!-- This means we can filter by the actual class doing the logging -->

    <!-- AI-specific loggers - DEBUG for gameplay visibility -->
    <logger name="com.developingstorm.games.sad.brain" level="DEBUG" />
    <logger name="com.developingstorm.games.sad.brain.TransportCaptain" level="DEBUG" />
    <logger name="com.developingstorm.games.sad.brain.General" level="DEBUG" />
    <logger name="com.developingstorm.games.sad.brain.RobotBrain" level="DEBUG" />
    <logger name="com.developingstorm.games.sad.brain.Battleplan" level="DEBUG" />
    <logger name="com.developingstorm.games.sad.brain.OperationsCoordinator" level="DEBUG" />

    <!-- Game core - DEBUG for game state tracking -->
    <logger name="com.developingstorm.games.sad.Game" level="DEBUG" />
    <logger name="com.developingstorm.games.sad.Player" level="DEBUG" />

    <!-- Movement and pathing - INFO to avoid spam, set to DEBUG if debugging movement -->
    <logger name="com.developingstorm.games.sad.PathCalculator" level="INFO" />
    <logger name="com.developingstorm.games.sad.Path" level="INFO" />
    <logger name="com.developingstorm.games.sad.MovementResolver" level="INFO" />
    <logger name="com.developingstorm.games.astar" level="INFO" />
    <logger name="com.developingstorm.games.astar.AStar" level="INFO" />

    <!-- Generic Log wrapper - DEBUG for all game events -->
    <logger name="com.developingstorm.games.sad.util.Log" level="DEBUG" />

    <!-- Combat - DEBUG for combat details -->
    <logger name="com.developingstorm.games.sad.CombatResolver" level="DEBUG" />

    <!-- Units - DEBUG for unit actions -->
    <logger name="com.developingstorm.games.sad.Unit" level="DEBUG" />
    <logger name="com.developingstorm.games.sad.UnitManager" level="DEBUG" />

    <!-- Cities - DEBUG for production and management -->
    <logger name="com.developingstorm.games.sad.City" level="DEBUG" />
    <logger name="com.developingstorm.games.sad.CityManager" level="DEBUG" />

    <!-- Board and vision - DEBUG for fog of war issues -->
    <logger name="com.developingstorm.games.sad.Board" level="DEBUG" />
    <logger name="com.developingstorm.games.sad.VisionManager" level="DEBUG" />

    <!-- Orders - DEBUG for order execution -->
    <logger name="com.developingstorm.games.sad.orders" level="DEBUG" />

    <!-- JavaFX UI - DEBUG for UI events -->
    <logger name="com.developingstorm.games.sad.fx" level="DEBUG" />

    <!-- Persistence - DEBUG for save/load -->
    <logger name="com.developingstorm.games.sad.persistence" level="DEBUG" />

    <!-- Root logger - logs to console and file for normal gameplay -->
    <root level="INFO">
        <appender-ref ref="STDOUT" />
        <appender-ref ref="FILE" />
    </root>

    <!--
    TO ENABLE VERBOSE LOGGING FOR GAMEPLAY DEBUGGING:
    Run the game with: -Dlogback.configurationFile=logback-gameplay-verbose.xml

    Or set the system property in your IDE/run configuration:
    System.setProperty("logback.configurationFile", "logback-gameplay-verbose.xml");
    -->

</configuration>

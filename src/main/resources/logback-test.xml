<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- File appender for detailed game logs -->
    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>game_test.log</file>
        <append>false</append>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- No console appender - all logs go to file only -->
    <!-- System.out (turn monitoring) will still be visible -->

    <!-- IMPORTANT: The Log wrapper now uses the context object's class for the logger -->
    <!-- This means we can filter by the actual class doing the logging -->

    <!-- AI-specific loggers - kept at INFO for AI testing -->
    <logger name="com.developingstorm.games.sad.brain" level="INFO" />
    <logger name="com.developingstorm.games.sad.brain.TransportCaptain" level="INFO" />
    <logger name="com.developingstorm.games.sad.brain.General" level="INFO" />
    <logger name="com.developingstorm.games.sad.brain.RobotBrain" level="INFO" />
    <logger name="com.developingstorm.games.sad.brain.Battleplan" level="INFO" />
    <logger name="com.developingstorm.games.sad.brain.OperationsCoordinator" level="INFO" />

    <!-- Game core - can be set to WARN to reduce noise during AI testing -->
    <logger name="com.developingstorm.games.sad.Game" level="INFO" />

    <!-- Movement and pathing - often verbose, set to WARN to reduce noise -->
    <logger name="com.developingstorm.games.sad.PathCalculator" level="WARN" />
    <logger name="com.developingstorm.games.sad.Path" level="WARN" />
    <logger name="com.developingstorm.games.sad.MovementResolver" level="WARN" />
    <logger name="com.developingstorm.games.astar" level="WARN" />
    <logger name="com.developingstorm.games.astar.AStar" level="WARN" />

    <!-- Suppress generic Log wrapper for pathfinding spam -->
    <logger name="com.developingstorm.games.sad.util.Log" level="WARN" />

    <!-- Combat - can be verbose, set to WARN unless debugging combat -->
    <logger name="com.developingstorm.games.sad.CombatResolver" level="WARN" />

    <!-- Units - very verbose, set to WARN -->
    <logger name="com.developingstorm.games.sad.Unit" level="WARN" />
    <logger name="com.developingstorm.games.sad.UnitManager" level="WARN" />

    <!-- Cities - moderately verbose, set to WARN -->
    <logger name="com.developingstorm.games.sad.City" level="WARN" />
    <logger name="com.developingstorm.games.sad.CityManager" level="WARN" />

    <!-- Board and vision - can be verbose -->
    <logger name="com.developingstorm.games.sad.Board" level="WARN" />
    <logger name="com.developingstorm.games.sad.VisionManager" level="WARN" />

    <!-- Orders - can be verbose, set to WARN -->
    <logger name="com.developingstorm.games.sad.orders" level="WARN" />

    <!-- Root logger - all logs go to file only -->
    <root level="INFO">
        <appender-ref ref="FILE" />
    </root>
</configuration>
